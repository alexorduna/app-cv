# Configuración local de Chamba. Este archivo se copia a .env la primera vez.
# Todo funciona sin editar nada.

# Ruta de la base de datos SQLite (relativa a la carpeta del proyecto)
DATABASE_PATH=data/chamba.db

# Proveedor de IA para cartas: mock | ollama | anthropic
# "mock" no usa red y sirve para probar. Puedes cambiarlo también en Configuración.
IA_PROVEEDOR=mock

# Ollama local (opcional): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# Anthropic (opcional). Si lo dejas vacío, el proveedor anthropic queda deshabilitado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5

# Next.js sin telemetría
NEXT_TELEMETRY_DISABLED=1

# ----- Google Sheet como base de datos (opcional) -----
# Si defines GOOGLE_SHEET_ID, la app usa tu Google Sheet en lugar de data/chamba.db.
# Acepta el ID o la URL completa del Sheet.
GOOGLE_SHEET_ID=
# Llave de la cuenta de servicio: el JSON completo (o en base64), o la ruta a un archivo.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# ----- Sitio en línea (Netlify) -----
# Si defines CHAMBA_CLAVE, el sitio pide usuario y contraseña.
CHAMBA_USUARIO=alex
CHAMBA_CLAVE=
# 1 = la búsqueda corre en GitHub Actions (en Netlify las funciones se cortan a los pocos segundos).
CHAMBA_BUSQUEDA_EXTERNA=
# Para el enlace "Correr búsqueda ahora" (owner/repo de GitHub).
CHAMBA_REPO_GITHUB=alexorduna/app-cv
