# Configuración local de Chamba. Este archivo se copia a .env la primera vez.
# Todo funciona sin editar nada.

# Ruta de la base de datos SQLite (relativa a la carpeta del proyecto)
DATABASE_PATH=data/chamba.db

# Proveedor de IA para cartas: mock | ollama | anthropic
# "mock" no usa red y sirve para probar. Puedes cambiarlo también en Configuración.
IA_PROVEEDOR=mock

# Ollama local (opcional): https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=llama3.1

# Anthropic (opcional). Si lo dejas vacío, el proveedor anthropic queda deshabilitado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODELO=claude-sonnet-5-5

# Next.js sin telemetría
NEXT_TELEMETRY_DISABLED=1
