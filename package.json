{
  "name": "chamba",
  "version": "0.1.0",
  "private": true,
  "description": "Chamba: busca y prepara aplicaciones a vacantes remotas de forma supervisada.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -p 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:generate": "drizzle-kit generate",
    "import": "tsx scripts/importar.ts",
    "export": "tsx scripts/exportar.ts",
    "seed": "tsx scripts/semilla.ts",
    "buscar": "tsx scripts/buscar.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "drizzle-orm": "0.45.4",
    "next": "15.5.28",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
